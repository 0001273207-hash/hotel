<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hotel - Sistema de Reservas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f4f6f9;
            font-family: Arial, Helvetica, sans-serif;
            color: #343a40;
        }

        /* CABEÇALHO */
        .navbar-custom {
            background: linear-gradient(135deg, #0d6efd, #084298);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.4rem;
        }

        /* TÍTULOS */
        .titulo-principal {
            font-weight: 700;
            color: #084298;
        }

        .subtitulo {
            color: #6c757d;
        }

        /* BOTÕES */
        .btn {
            border-radius: 8px;
            font-weight: 600;
            padding: 9px 18px;
            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        /* ÁREA DE EXEMPLOS */
        .painel {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.07);
        }

        /* ALERTAS */
        .alert {
            border: none;
            border-radius: 10px;
            font-weight: 500;
        }

        /* TABELA */
        .table-container {
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.07);
        }

        .table {
            margin-bottom: 0;
            vertical-align: middle;
        }

        .table th {
            text-transform: uppercase;
            font-size: 0.85rem;
        }

        .table td {
            padding: 15px;
        }

        /* CARDS */
        .card {
            border-radius: 15px;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
        }

        .card-title {
            font-weight: 700;
        }

        .icone-card {
            font-size: 40px;
            margin-bottom: 10px;
        }

        /* PREÇO */
        .preco {
            font-size: 1.4rem;
            font-weight: bold;
            color: #198754;
        }

        /* RODAPÉ */
        footer {
            margin-top: 50px;
            background: #212529;
            color: white;
            padding: 25px;
            text-align: center;
            border-radius: 15px 15px 0 0;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="#">
                🏨 Hotel Paradise
            </a>

            <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Início</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#quartos">Quartos</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#clientes">Clientes</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <main class="container py-5">

        <!-- TÍTULO -->
        <div class="text-center mb-5">
            <h1 class="titulo-principal">
                Sistema de Reservas
            </h1>

            <p class="subtitulo">
                Gerencie quartos, clientes e reservas de forma simples.
            </p>
        </div>


        <!-- BOTÕES -->
        <section class="painel">

            <h2 class="mb-4">🎨 Botões de Exemplo</h2>

            <button class="btn btn-primary">
                Botão Principal
            </button>

            <button class="btn btn-success">
                Salvar / Confirmar
            </button>

            <button class="btn btn-outline-danger">
                Excluir / Erro
            </button>

            <button class="btn btn-outline-warning">
                Atenção
            </button>

        </section>


        <!-- ALERTAS -->
        <section class="painel">

            <h2 class="mb-4">🔔 Alertas</h2>

            <div class="alert alert-success">
                ✅ Operação realizada com sucesso!
            </div>

            <div class="alert alert-danger">
                ❌ Erro: Usuário ou senha incorretos.
            </div>

            <div class="alert alert-warning">
                ⚠️ Atenção: verifique os dados antes de continuar.
            </div>

        </section>


        <!-- TABELA -->
        <section id="quartos" class="mb-5">

            <div class="table-container">

                <h2 class="mb-4">
                    🛏️ Quartos Disponíveis
                </h2>

                <div class="table-responsive">

                    <table class="table table-striped table-hover">

                        <thead class="table-dark">

                            <tr>
                                <th>ID</th>
                                <th>NÚMERO</th>
                                <th>TIPO</th>
                                <th>PREÇO</th>
                                <th>STATUS</th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>
                                <td>1</td>
                                <td>101</td>
                                <td>Suíte Presidencial</td>
                                <td class="preco">R$ 450,00</td>
                                <td>
                                    <span class="badge bg-success">
                                        Disponível
                                    </span>
                                </td>
                            </tr>

                            <tr>
                                <td>2</td>
                                <td>102</td>
                                <td>Casal</td>
                                <td class="preco">R$ 300,00</td>
                                <td>
                                    <span class="badge bg-success">
                                        Disponível
                                    </span>
                                </td>
                            </tr>

                            <tr>
                                <td>3</td>
                                <td>103</td>
                                <td>Solteiro</td>
                                <td class="preco">R$ 100,00</td>
                                <td>
                                    <span class="badge bg-danger">
                                        Ocupado
                                    </span>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </section>


        <!-- ÁREAS DO SISTEMA -->
        <section id="clientes">

            <div class="text-center mb-4">

                <h2 class="titulo-principal">
                    Escolha uma Opção
                </h2>

                <p class="subtitulo">
                    Acesse uma das áreas do sistema.
                </p>

            </div>


            <div class="row g-4">

                <!-- CLIENTE -->
                <div class="col-md-6">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body text-center p-5">

                            <div class="icone-card">
                                👤
                            </div>

                            <h3 class="card-title text-success">
                                Área do Cliente
                            </h3>

                            <p class="card-text text-muted">
                                Faça seu login para visualizar suas
                                reservas e informações pessoais.
                            </p>

                            <a href="#" class="btn btn-success">
                                Acessar Conta
                            </a>

                        </div>

                    </div>

                </div>


                <!-- ADMINISTRADOR -->
                <div class="col-md-6">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body text-center p-5">

                            <div class="icone-card">
                                🔐
                            </div>

                            <h3 class="card-title text-primary">
                                Área Administrativa
                            </h3>

                            <p class="card-text text-muted">
                                Gerencie quartos, reservas, clientes
                                e informações do hotel.
                            </p>

                            <a href="#" class="btn btn-primary">
                                Acessar Painel
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- RODAPÉ -->
    <footer>

        <p class="mb-1">
            🏨 <strong>Hotel Paradise</strong>
        </p>

        <small>
            Sistema de Reservas © 2026
        </small>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
